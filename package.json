{
  "name": "fastify-tma",
  "type": "module",
  "version": "0.0.3",
  "packageManager": "pnpm@12.16.1",
  "description": "Fastify plugin for Telegram Mini Apps integration.",
  "author": "Viktor Zdorovtsev",
  "license": "MIT",
  "funding": "https://github.com/sponsors/blasdfaa",
  "homepage": "https://github.com/blasdfaa/fastify-tma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blasdfaa/fastify-tma.git"
  },
  "bugs": "https://github.com/blasdfaa/fastify-tma/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/migration.md"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm test:package",
    "dev": "vitest dev",
    "lint": "eslint .",
    "prepare": "lefthook install",
    "prepack": "pnpm build",
    "release": "pnpm check && bumpp && pnpm publish --access public",
    "test": "pnpm test:unit && pnpm test:types",
    "test:unit": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node --test test/package.test.mjs",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "@fastify/error": "^4.2.1",
    "@tma.js/init-data-node": "^2.0.8",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^10.13.0",
    "fastify": "^5.12.7",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
